generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Municipio {
  id    Int @id @default(autoincrement())
  nome  String @unique
  dados DadosFinanceiros[]
}

model DadosFinanceiros {
  id           Int @id @default(autoincrement())
  ano          Int
  rcl          Decimal  @db.Decimal(20, 2)
  dtp          Decimal  @db.Decimal(20, 2)
  fundeb       Decimal? @db.Decimal(20, 2)
  municipioId  Int
  municipio    Municipio @relation( fields: [municipioId], references: [id])

  @@unique([municipioId, ano])
}

model PSPN {
  id       Int      @id @default(autoincrement())
  ano      Int
  nivel    String
  classe   Int
  salario  Decimal  @db.Decimal(15,2)
}

model SalarioMunicipio {
  id          Int      @id @default(autoincrement())
  municipio   String
  ano         Int
  nivel       String
  classe      Int
  salario     Decimal  @db.Decimal(15,2)
}